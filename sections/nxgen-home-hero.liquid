<section class="nx-hero" aria-labelledby="NxHero-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2560 | image_tag: class: 'nx-hero__image', widths: '640, 960, 1280, 1600, 2000, 2560', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
  {%- endif -%}
  <div class="nx-shell nx-hero__inner">
    <div class="nx-hero__copy">
      <h1 id="NxHero-{{ section.id }}" class="nx-display">{{ section.settings.heading | escape }}</h1>
      <p>{{ section.settings.description | escape }}</p>
      {%- if section.settings.button_label != blank -%}
        <a class="nx-button nx-button--light" href="{{ section.settings.button_link | default: '#training-gear' }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NXGEN homepage hero",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Campaign image" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Make every session count" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Footballs, training gear and matchday essentials for players who put in the work." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the gear" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "NXGEN homepage hero" }]
}
{% endschema %}
