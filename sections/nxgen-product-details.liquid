{%- liquid
  assign detail_image = section.settings.image | default: product.metafields.custom.detail_image.value.preview_image
-%}
{%- capture specifications -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign field = product.metafields.custom[block.settings.field]
      assign value = block.settings.value | default: field.value
    -%}
    {%- if value != blank or request.design_mode -%}
      <div class="nx-specs__row" {{ block.shopify_attributes }}>
        <dt>{{ block.settings.label | escape }}</dt>
        <dd>
          {%- if block.settings.value != blank -%}
            {{ block.settings.value | escape | newline_to_br }}
          {%- elsif field.value != blank -%}
            {{ field | metafield_tag }}
          {%- else -%}
            {{ section.settings.empty_row | escape }}
          {%- endif -%}
        </dd>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if specifications != blank or detail_image != blank -%}
  <section class="nx-specs" aria-labelledby="NxSpecs-{{ section.id }}">
    <div class="nx-shell nx-specs__inner{% if detail_image != blank %} nx-specs__inner--with-image{% endif %}">
      <div>
        <h2 id="NxSpecs-{{ section.id }}" class="nx-display">{{ section.settings.heading | escape }}</h2>
        {%- if specifications != blank -%}
          <dl class="nx-specs__list">{{ specifications }}</dl>
        {%- endif -%}
      </div>
      {%- if detail_image != blank -%}
        <div class="nx-specs__media">
          {{ detail_image | image_url: width: 1400 | image_tag: widths: '420, 720, 1000, 1400', sizes: '(min-width: 750px) 45vw, 100vw', loading: 'lazy' }}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "NXGEN product details",
  "enabled_on": { "templates": ["product"] },
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product details" },
    { "type": "image_picker", "id": "image", "label": "Optional detail image" },
    { "type": "text", "id": "empty_row", "label": "Editor placeholder", "default": "Add a value here or set the corresponding product metafield." }
  ],
  "blocks": [
    {
      "type": "specification",
      "name": "Product detail",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Size" },
        {
          "type": "select", "id": "field", "label": "Product metafield in the custom namespace", "default": "football_size",
          "options": [
            { "value": "football_size", "label": "Football size" },
            { "value": "recommended_surfaces", "label": "Recommended surfaces" },
            { "value": "construction", "label": "Construction" },
            { "value": "whats_included", "label": "What’s included" },
            { "value": "fit", "label": "Fit" },
            { "value": "sizing", "label": "Sizing" }
          ]
        },
        { "type": "textarea", "id": "value", "label": "Optional override", "info": "This override applies to every product using this template. For individual product details, use product metafields." }
      ]
    }
  ],
  "presets": [{ "name": "NXGEN product details", "blocks": [{ "type": "specification" }] }]
}
{% endschema %}
